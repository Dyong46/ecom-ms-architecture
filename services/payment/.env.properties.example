# Copy to services/payment/.env.properties (ignored by Git).
# Run PaymentApplication with the repository root as its working directory.
# Use plain properties values: no export prefix or surrounding quotes.

# Set true only after filling in both sandbox secrets below, then restart Payment.
STRIPE_ENABLED=false

# Stripe Dashboard -> select Sandbox -> API keys -> Secret key (sk_test_...).
STRIPE_SECRET_KEY=

# Run: stripe login
# Then: stripe listen --forward-to localhost:8222/webhooks/stripe
# Paste the signing secret (whsec_...) printed by that listener. Keep it running.
STRIPE_WEBHOOK_SECRET=

# Frontend return destinations; these pages are not implemented in this repo yet.
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Copy to cloud/api-gateway/.env.properties (ignored by Git).
# Run GatewayApplication with the repository root as its working directory.
# Plain properties syntax: no export prefix or surrounding quotes.
# Restart Gateway after editing this file.

# Must match the issuer claim of access tokens issued by your local Keycloak.
JWT_ISSUER_URI=http://localhost:9098/realms/micro-services

# Gateway validates JWTs using the issuer; no Stripe key or OAuth client secret needed.
# For optional Spring Boot overrides, use canonical property names, for example:
# server.port=8222
# eureka.client.service-url.defaultZone=http://localhost:8761/eureka

# Local profile; replaces --spring.profiles.active=local in program arguments.
spring.profiles.active=local

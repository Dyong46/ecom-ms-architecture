                "editorMode": "code",
                "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"kafka-exporter\",consumergroup=\"paymentGroup,orderGroup\",topic=~\"order-topic|payment-topic\"} >= 0)",

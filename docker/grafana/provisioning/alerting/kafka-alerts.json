                "editorMode": "code",
                "expr": "(sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"kafka-exporter\",consumergroup=\"paymentGroup,orderGroup\",topic=~\"order-topic|payment-topic\"} >= 0) > 0) and on(consumergroup,topic) (sum by (consumergroup, topic) (changes(kafka_consumergroup_current_offset{job=\"kafka-exporter\",consumergroup=\"paymentGroup,orderGroup\",topic=~\"order-topic|payment-topic\"}[1m])) == 0)",
